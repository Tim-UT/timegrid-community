[Unit]
Description=TimeGrid Community calendar repository
After=network.target

[Service]
User=timegrid-community
Group=timegrid-community
WorkingDirectory=/opt/timegrid-community
EnvironmentFile=/etc/timegrid-community.env
ExecStart=/opt/timegrid-community/.venv/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:9210 'app:create_app()'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timegrid-community

[Install]
WantedBy=multi-user.target
